# Copy to .env and fill in real values. Never commit .env.

# Runtime DB — Supabase transaction pooler (port 6543, pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Migrations DB — session pooler (port 5432) or direct host if IPv6-capable
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Required: >= 32 chars or the app refuses to start (openssl rand -base64 48)
SESSION_SECRET="PASTE_openssl_rand_base64_48_output_here_please"

# Used only by `npm run seed` on an EMPTY database — do not re-seed a migrated DB
ADMIN_EMAIL="admin@suzzmed.local"
ADMIN_PASSWORD="change-me-before-seeding"

NEXT_PUBLIC_SITE_NAME="Suzzmed Healthcare"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
